<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>Escorp.Atom.SourceGeneration</AssemblyName>

		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IncludeBuildOutput>true</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<CompilerGeneratedFilesOutputPath>generated</CompilerGeneratedFilesOutputPath>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<NoWarn>CA1031;CA1716;CA1724;RS1041;NU5128</NoWarn>

		<PackageId>$(AssemblyName)</PackageId>
		<Version>0.6.8</Version>
		<Authors>Yuriy Yesin, Escorp Labs</Authors>
		<Company>Escorp Dynamics</Company>
		<Product>Escorp.$(AssemblyName)</Product>
		<RepositoryUrl>https://gitflic.ru/project/escorp-lab/atom</RepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageIcon>icon.png</PackageIcon>
		<PackageTags>atom;framework;escorp;exomode;system;threading;log;debug;extension;web</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<!-- Исключаем сохранённые generated-файлы из компиляции, чтобы избежать CS0757 -->
	<ItemGroup>
		<Compile Remove="$(CompilerGeneratedFilesOutputPath)/**" />
	</ItemGroup>

	<!--
		При использовании через ProjectReference (OutputItemType="Analyzer")
		компилятор получает только основную DLL генератора.
		NuGet решает это автоматически — все файлы из analyzers/dotnet/cs попадают в контекст.
		Для ProjectReference экспортируем зависимости через TargetPathWithTargetPlatformMoniker,
		чтобы потребители получили их вместе с анализатором.
	-->
	<Target Name="_IncludeAnalyzerDependencies"
		AfterTargets="GetTargetPathWithTargetPlatformMoniker"
		Condition="'$(DisableAnalyzerDependencyInclusion)' != 'true'">
		<ItemGroup>
			<TargetPathWithTargetPlatformMoniker
				Include="$(MSBuildProjectDirectory)/$(OutputPath)Escorp.Atom.dll">
				<TargetFrameworkMoniker>$(TargetFrameworkMoniker)</TargetFrameworkMoniker>
			</TargetPathWithTargetPlatformMoniker>
		</ItemGroup>
	</Target>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug' or '$(UseAtomProjectReferences)' == 'true'">
		<ProjectReference Include="../Atom/Atom.csproj"
			AdditionalProperties="DisableAnalyzerDependencyInclusion=$(DisableAnalyzerDependencyInclusion)" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release' and '$(UseAtomProjectReferences)' != 'true'">
		<PackageReference Include="Escorp.Atom" Version="*" GeneratePathProperty="true" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="*" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Atom.SourceGeneration.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Update="icon.png" PackagePath="\" Pack="true" />
		<None Update="README.md" PackagePath="\" Pack="true" />
	</ItemGroup>

	<!--
		Файлы анализатора добавляются в пакет на старте Pack-цели: при GeneratePackageOnBuild
		pack выполняется в той же MSBuild-сессии после сборки, и к этому моменту выходные
		файлы уже существуют. Статический ItemGroup с условиями Exists() оценивается ДО сборки —
		на чистой машине условия дают false, и пакет уходит на nuget.org без analyzers/
		(так получился битый Escorp.Atom.SourceGeneration 0.6.7).
		Escorp.Atom.dll берётся из кеша пакетов через $(PkgEscorp_Atom) (GeneratePathProperty),
		чтобы не зависеть от CopyLocalLockFileAssemblies и времени копирования.
	-->
	<Target Name="_IncludeAnalyzerPackFiles" BeforeTargets="_GetPackageFiles"
		Condition="'$(DisableAnalyzerDependencyInclusion)' != 'true'">
		<ItemGroup>
			<None Include="$(OutputPath)$(AssemblyName).dll" Pack="true"
				PackagePath="analyzers/dotnet/cs" Visible="false" />
			<None Include="$(OutputPath)$(AssemblyName).pdb" Pack="true"
				PackagePath="analyzers/dotnet/cs" Visible="false" />
			<None Include="$(OutputPath)$(AssemblyName).xml" Pack="true"
				PackagePath="analyzers/dotnet/cs" Visible="false" />
			<None Include="$(PkgEscorp_Atom)/lib/$(TargetFramework)/Escorp.Atom.dll" Pack="true"
				PackagePath="analyzers/dotnet/cs" Visible="false" />
		</ItemGroup>
	</Target>

</Project>