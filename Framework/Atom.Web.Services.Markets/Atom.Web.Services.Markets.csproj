<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OptimizationPreference>speed</OptimizationPreference>
        <AssemblyName>Escorp.Atom.Web.Services.Markets</AssemblyName>
        <!-- CA1062 остаётся на protected-точках расширения ExchangeClientBase — аргументы туда
        передаёт сама база. -->
        <NoWarn>
            AsyncFixer01;CA1003;CA1028;CA1031;CA1032;CA1034;CA1051;CA1054;CA1056;CA1062;CA1063;CA1816;CA1819;CA1822;CA1823;CA2201;CA2227;CA2234;CA5394;ERP022;IDE0005;IDE0007;IDE0011;IDE0021;IDE0022;IDE0032;IDE0042;IDE0045;IDE0047;IDE0048;IDE0051;IDE0052;IDE0055;IDE0059;IDE0078;IDE0200;IDE0290;IDE0305;IDE0330;IDE0350;IL2026;IL3050;MA0002;MA0003;MA0006;MA0007;MA0011;MA0015;MA0016;MA0038;MA0042;MA0051;MA0076;MA0089;MA0099;MA0105;MA0106;MA0158;MA0182;MA0196;RCS1139;RCS1194;S1066;S1075;S108;S1135;S1144;S1481;S1751;S1854;S1939;S2325;S3358;S3626;S3776;S3881;S4487;S6612;S8949;S8969;SCS0005;VSTHRD002;VSTHRD003</NoWarn>

        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <WarningLevel>9999</WarningLevel>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>

        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
        <InvariantGlobalization>true</InvariantGlobalization>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

        <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
        <IlcOptimizationPreference>speed</IlcOptimizationPreference>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>$(AssemblyName)</PackageId>
        <Version>0.0.1</Version>
        <Authors>Yuriy Yesin, Escorp Labs</Authors>
        <Company>Escorp Dynamics</Company>
        <Product>Escorp.$(AssemblyName)</Product>
        <RepositoryUrl>https://gitflic.ru/project/escorp-lab/atom</RepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>atom;framework;escorp;markets;trading;strategy;risk;backtesting;web;services</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
        <RunAnalyzers>false</RunAnalyzers>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <AnalysisMode>None</AnalysisMode>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <ProjectReference Include="../Atom.Web.Services/Atom.Web.Services.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <PackageReference Include="Escorp.Atom.Web.Services" Version="*" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="../Atom.Web.Services/icon.png" Link="icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>