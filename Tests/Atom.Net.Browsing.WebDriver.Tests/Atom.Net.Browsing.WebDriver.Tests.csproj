<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableNUnitRunner>true</EnableNUnitRunner>
        <OutputType>Exe</OutputType>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <!-- .NET 10 по умолчанию скрывает детали test failures в отдельном .log;
             оставляем их в stdout, чтобы обязательный CI-check был диагностируемым. -->
        <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
        <TrimMode>link</TrimMode>
    </PropertyGroup>

    <!-- Hosted Ubuntu runners do not provide a stable real-browser matrix. The mandatory
         gate therefore executes the deterministic loopback/proxy hardening suite; set
         RunWebDriverBrowserIntegrationTests=true in a provisioned browser environment to
         execute the complete suite instead. -->
    <PropertyGroup Condition="'$(CI)' == 'true' and '$(RunWebDriverBrowserIntegrationTests)' != 'true'">
        <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --filter FullyQualifiedName~WebDriverTransportHardeningTests</TestingPlatformCommandLineArguments>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="*" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="*" />
        <PackageReference Include="NUnit" Version="*" />
        <PackageReference Include="coverlet.collector" Version="*">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="NUnit.Analyzers" Version="*">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="NUnit3TestAdapter" Version="*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference
            Include="../../Framework/Atom.Net.Browsing.WebDriver/Atom.Net.Browsing.WebDriver.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework" />
    </ItemGroup>

</Project>